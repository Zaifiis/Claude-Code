# Content OS portal — Apache/LiteSpeed config (Hostinger honours .htaccess).
# Every directive is guarded so an unsupported one can't 500 the whole site.

DirectoryIndex index.php

# Never serve config, SQL or database files directly.
<FilesMatch "\.(sql|sqlite|sqlite3|db)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<Files "config.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Block direct access to the includes directory.
<IfModule mod_alias.c>
  RedirectMatch 403 ^/?.*/inc/.*$
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
