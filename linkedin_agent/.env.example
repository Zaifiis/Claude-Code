# LinkedIn Series Agent — Credentials
# ------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# No Anthropic API key needed — uses the claude CLI you already have installed.

# Gmail address you'll send FROM (must have 2FA enabled)
GMAIL_USER=yourname@gmail.com

# Gmail App Password (NOT your regular password)
# How to get it:
#   1. Go to Google Account → Security → 2-Step Verification
#   2. Scroll to "App passwords" at the bottom
#   3. Create a new app password → select "Mail" + "Linux computer"
#   4. Copy the 16-character password here (no spaces)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Email address to RECEIVE the daily LinkedIn outline
# (can be the same as GMAIL_USER or any other inbox)
NOTIFY_EMAIL=yourname@gmail.com
