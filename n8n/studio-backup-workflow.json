{
  "name": "Content Studio — daily Drive backup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 3
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "id": "studio-backup-schedule",
      "name": "Every night at 3am"
    },
    {
      "parameters": {
        "url": "=https://zaifiiscontentdash.netlify.app/api/studio/export",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-studio-token",
              "value": "PUT-YOUR-STUDIO_BACKUP_TOKEN-HERE"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "studio"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "id": "studio-backup-fetch",
      "name": "Fetch the export"
    },
    {
      "parameters": {
        "jsCode": "// Refuse to back up an empty or broken export. A backup that quietly\n// overwrites yesterday's good copy with nothing is worse than no backup.\nconst body = $input.first().json.studio;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(body);\n} catch (error) {\n  throw new Error('Studio export was not valid JSON — leaving yesterday\\'s backup alone.');\n}\n\nif (!Array.isArray(parsed.ideas)) {\n  throw new Error('Studio export had no ideas array — leaving yesterday\\'s backup alone.');\n}\n\nif (parsed.ideas.length === 0 && (parsed.todos ?? []).length === 0) {\n  throw new Error('Studio export was empty — leaving yesterday\\'s backup alone.');\n}\n\nconst stamp = new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    filename: `content-studio-${stamp}.json`,\n    ideas: parsed.ideas.length,\n    todos: (parsed.todos ?? []).length,\n  },\n  binary: {\n    data: await this.helpers.prepareBinaryData(\n      Buffer.from(body, 'utf8'),\n      `content-studio-${stamp}.json`,\n      'application/json',\n    ),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "id": "studio-backup-check",
      "name": "Check it is not empty"
    },
    {
      "parameters": {
        "name": "={{ $json.filename }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "value": "root",
          "mode": "list",
          "cachedResultName": "My Drive"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [660, 0],
      "id": "studio-backup-upload",
      "name": "Upload to Drive",
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "dtAjZFjZwhNnNKqa",
          "name": "Google Drive account"
        }
      }
    }
  ],
  "connections": {
    "Every night at 3am": {
      "main": [[{ "node": "Fetch the export", "type": "main", "index": 0 }]]
    },
    "Fetch the export": {
      "main": [[{ "node": "Check it is not empty", "type": "main", "index": 0 }]]
    },
    "Check it is not empty": {
      "main": [[{ "node": "Upload to Drive", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
