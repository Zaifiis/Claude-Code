# ═══════════════════════════════════════════════════════════════════════════
#  Kairo — Apache / LiteSpeed configuration (Hostinger runs LiteSpeed, which
#  reads this file the same way).
#
#  Upload this with the site. If it goes missing you lose clean URLs, the
#  HTTPS redirect and the 404 page.
# ═══════════════════════════════════════════════════════════════════════════

Options -Indexes
ServerSignature Off
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Force HTTPS ──────────────────────────────────────────────────────────
  # Comment this block out until your SSL certificate is issued, or the site
  # will redirect to a certificate that does not exist yet.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── One canonical host: drop the www ─────────────────────────────────────
  # Prefer www instead? Swap this rule for the inverse.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ── Pretty URLs ──────────────────────────────────────────────────────────
  # /contact.php redirects to /contact. GET only: redirecting a POST would
  # drop the form data on the floor.
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # …and /contact serves contact.php.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]

  # Sitemap is generated, not a file on disk.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

ErrorDocument 404 /404.php

# ── Keep internals out of the browser ──────────────────────────────────────
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(env|sql|log|md|json|lock|ini|sh|bak|old)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ── Headers ────────────────────────────────────────────────────────────────
# PHP pages set their own; this covers static files (CSS, JS, images).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always unset X-Powered-By
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Caching ────────────────────────────────────────────────────────────────
# CSS and JS carry a ?v= stamp that changes when the file does, so a long
# max-age is safe. HTML is never cached — it holds CSRF tokens.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 week"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Uploads ────────────────────────────────────────────────────────────────
<IfModule mod_php.c>
  php_flag  display_errors        off
  php_flag  expose_php            off
  php_value upload_max_filesize   8M
  php_value post_max_size         8M
</IfModule>
