# ─────────────────────────────────────────────────────────────────────────────
# Kairo site configuration
#
# Copy this file to `.env` (same folder as public_html) and fill it in.
# NEVER commit the real .env — it holds your database password and app key.
# ─────────────────────────────────────────────────────────────────────────────

# production | development
APP_ENV=production

# Public base URL, no trailing slash. Used for canonical tags + sitemap.
APP_URL=https://example.com

# 64-char random secret. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=

# ── Brand ────────────────────────────────────────────────────────────────────
# Everything user-facing reads from here. Change these three lines and the
# whole site rebrands.
BRAND_NAME=Kairo
BRAND_TAGLINE=AI automation for teams that are done doing it manually
BRAND_EMAIL=hello@example.com
BRAND_PHONE=
BRAND_CALENDAR_URL=
BRAND_LINKEDIN_URL=

# ── Database ─────────────────────────────────────────────────────────────────
# On Hostinger: hPanel → Databases → MySQL Databases. Host stays `localhost`.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# For local testing without MySQL, set DB_DRIVER=sqlite and point DB_NAME at a
# writable file path, e.g. DB_NAME=/home/you/kairo.sqlite
# ── Mail ─────────────────────────────────────────────────────────────────────
# smtp (recommended on Hostinger) | mail (PHP mail()) | log (writes to storage/)
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
# ssl | tls | none
MAIL_ENCRYPTION=ssl
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Kairo Website
# Where new-lead notifications land. Defaults to BRAND_EMAIL when blank.
MAIL_TO=

# ── Admin ────────────────────────────────────────────────────────────────────
# The first admin account is created by db/schema.sql. See README step 4 for
# how to generate the password hash.
