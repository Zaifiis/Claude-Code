# Zaiqa Line frontend (Vite). Copy to client/.env and fill in.
# Browser-safe values only — anon key + public URLs. NEVER the service key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Leave unset in dev to use the Vite proxy (/voice -> localhost:3001).
# In production point this at the deployed backend, e.g. wss://api.example.com/voice
VITE_WS_URL=
