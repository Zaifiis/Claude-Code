# ── Zaiqa Line — environment variables ─────────────────────────────
# Copy this file to `.env` and fill in the real values locally.
# NEVER commit a filled-in .env — it is gitignored on purpose.

# OpenRouter (the AI brain). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-capable model, e.g. openai/gpt-4o-mini (cheap) or a :free model.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is SERVER-SIDE ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Backend HTTP port
PORT=3001

# ── Frontend (Vite) — client/.env ──────────────────────────────────
# These are safe to expose to the browser (anon key + public URLs only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
