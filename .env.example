# ── Zaiqa Line — environment variables ─────────────────────────────
# Copy this file to `.env` and fill in the real values locally.
# NEVER commit a filled-in .env — it is gitignored on purpose.

# Google Gemini Live API
GEMINI_API_KEY=
# Google rotates these model ids; read from env, never hardcode.
GEMINI_MODEL_ID=gemini-live-2.5-flash-preview-native-audio-09-2025

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key is SERVER-SIDE ONLY. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Backend HTTP + WebSocket port
PORT=3001

# ── Frontend (Vite) — client/.env ──────────────────────────────────
# These are safe to expose to the browser (anon key + public URLs only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_WS_URL=ws://localhost:3001/voice
